{
  "title": "RubricGrade",
  "type": "object",
  "additionalProperties": false,
  "required": ["criteria", "summary"],
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "met", "evidence", "feedback"],
        "properties": {
          "index": { "type": "integer" },
          "met": { "type": "boolean" },
          "evidence": { "type": "string", "maxLength": 600 },
          "feedback": { "type": "string", "minLength": 3, "maxLength": 500 }
        }
      }
    },
    "summary": { "type": "string", "minLength": 5, "maxLength": 600 }
  }
}
