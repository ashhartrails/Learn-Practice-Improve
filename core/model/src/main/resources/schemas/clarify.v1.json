{
  "title": "ClarifyingQuestions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questions"
  ],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "kind",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "question": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "choice",
              "text"
            ]
          },
          "options": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    }
  }
}
