{
  "title": "ChapterQuiz",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questions"
  ],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topicIndex",
          "question"
        ],
        "properties": {
          "topicIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "question": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "prompt",
              "options",
              "correct",
              "accepted",
              "explanation"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "single_choice",
                  "multi_choice",
                  "numeric",
                  "short_text"
                ]
              },
              "prompt": {
                "type": "string",
                "minLength": 5,
                "maxLength": 600
              },
              "options": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "correct": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                }
              },
              "number": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "tolerance": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 20
              },
              "accepted": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "explanation": {
                "type": "string",
                "minLength": 5,
                "maxLength": 600
              }
            }
          }
        }
      }
    }
  }
}
