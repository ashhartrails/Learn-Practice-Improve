{
  "title": "Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "whyItMatters",
    "cards",
    "workedExample",
    "tryIt",
    "checks"
  ],
  "properties": {
    "whyItMatters": {
      "type": "string",
      "minLength": 10,
      "maxLength": 400
    },
    "cards": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "body"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "body": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1500
          }
        }
      }
    },
    "workedExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "steps",
        "answer"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 10,
          "maxLength": 800
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 600
          }
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "tryIt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prompt",
        "options",
        "correct",
        "accepted",
        "explanation"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "single_choice",
            "multi_choice",
            "numeric",
            "short_text"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600
        },
        "options": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "correct": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "number": {
          "type": [
            "number",
            "null"
          ]
        },
        "tolerance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20
        },
        "accepted": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 5,
          "maxLength": 600
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "prompt",
          "options",
          "correct",
          "accepted",
          "explanation"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "single_choice",
              "multi_choice",
              "numeric",
              "short_text"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 5,
            "maxLength": 600
          },
          "options": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "correct": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          },
          "number": {
            "type": [
              "number",
              "null"
            ]
          },
          "tolerance": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "unit": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 20
          },
          "accepted": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 5,
            "maxLength": 600
          }
        }
      }
    }
  }
}
