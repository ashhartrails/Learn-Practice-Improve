{
  "title": "CourseOutline",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "chapters"],
  "properties": {
    "title": { "type": "string", "minLength": 3, "maxLength": 120, "description": "Course title." },
    "summary": { "type": "string", "minLength": 10, "maxLength": 600, "description": "Two or three sentences on what the learner will be able to do." },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "goal", "topics"],
        "properties": {
          "title": { "type": "string", "minLength": 3, "maxLength": 120 },
          "goal": { "type": "string", "minLength": 10, "maxLength": 300, "description": "A concrete, testable outcome for the chapter." },
          "topics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "objectives", "prerequisites", "estimatedMinutes"],
              "properties": {
                "title": { "type": "string", "minLength": 3, "maxLength": 120 },
                "objectives": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": { "type": "string", "minLength": 3, "maxLength": 200 }
                },
                "prerequisites": {
                  "type": "array",
                  "maxItems": 6,
                  "items": { "type": "string", "minLength": 2, "maxLength": 120 }
                },
                "estimatedMinutes": { "type": "integer", "minimum": 3, "maximum": 90 }
              }
            }
          }
        }
      }
    }
  }
}
